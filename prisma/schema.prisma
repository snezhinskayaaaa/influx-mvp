generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  INFLUENCER @map("influencer")
  BRAND      @map("brand")
  ADMIN      @map("admin")

  @@map("user_role")
}

enum CampaignStatus {
  DRAFT     @map("draft")
  ACTIVE    @map("active")
  PAUSED    @map("paused")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")

  @@map("campaign_status")
}

enum InfluencerStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")

  @@map("influencer_status")
}

enum CollaborationStatus {
  INVITED        @map("invited")
  APPLIED        @map("applied")
  NEGOTIATING    @map("negotiating")
  AGREED         @map("agreed")
  IN_PROGRESS    @map("in_progress")
  CONTENT_REVIEW @map("content_review")
  REVISION       @map("revision")
  PUBLISHING     @map("publishing")
  DELIVERED      @map("delivered")
  COMPLETED      @map("completed")
  CANCELLED      @map("cancelled")
  DISPUTED       @map("disputed")
  RESOLVED       @map("resolved")

  @@map("collaboration_status")
}

enum TransactionType {
  DEPOSIT              @map("deposit")
  WITHDRAWAL           @map("withdrawal")
  CAMPAIGN_FREEZE      @map("campaign_freeze")
  CAMPAIGN_UNFREEZE    @map("campaign_unfreeze")
  CAMPAIGN_ADVANCE     @map("campaign_advance")
  ADVANCE_REFUND       @map("advance_refund")
  CAMPAIGN_PAYOUT      @map("campaign_payout")
  CAMPAIGN_PAYOUT_AUTO @map("campaign_payout_auto")
  DISPUTE_PAYOUT       @map("dispute_payout")
  DISPUTE_REFUND       @map("dispute_refund")
  REFERRAL_PAYOUT      @map("referral_payout")

  @@map("transaction_type")
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Profile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String?  @map("full_name")
  role         UserRole @default(INFLUENCER)
  emailVerified Boolean  @default(false) @map("email_verified")
  avatarUrl     String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Two-Factor Authentication
  totpSecret    String?  @map("totp_secret")
  totpEnabled   Boolean  @default(false) @map("totp_enabled")
  totpBackupCodes String[] @default([]) @map("totp_backup_codes")

  // Token invalidation (JWT revocation on password change)
  tokenInvalidatedAt DateTime? @map("token_invalidated_at") @db.Timestamptz

  // Legal
  termsAcceptedAt DateTime? @map("terms_accepted_at") @db.Timestamptz

  // Analytics (admin-only, not exposed to user)
  referralSource String? @map("referral_source")

  // Notification preferences
  emailNotifications Boolean @default(true) @map("email_notifications")
  campaignUpdates    Boolean @default(true) @map("campaign_updates")

  influencer       Influencer?
  brand            Brand?
  transactions     Transaction[]
  notifications    Notification[]

  @@map("profiles")
}

model Influencer {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  handle String @unique
  bio    String?
  niche  String[] @default([])

  // Social media stats
  instagramHandle     String?  @map("instagram_handle")
  instagramFollowers  Int      @default(0) @map("instagram_followers")
  instagramEngagement Decimal  @default(0) @map("instagram_engagement") @db.Decimal(5, 2)
  instagramAvgViews   Int      @default(0) @map("instagram_avg_views")

  tiktokHandle     String?  @map("tiktok_handle")
  tiktokFollowers  Int      @default(0) @map("tiktok_followers")
  tiktokEngagement Decimal  @default(0) @map("tiktok_engagement") @db.Decimal(5, 2)
  tiktokAvgViews   Int      @default(0) @map("tiktok_avg_views")

  youtubeHandle      String?  @map("youtube_handle")
  youtubeSubscribers Int      @default(0) @map("youtube_subscribers")
  youtubeEngagement  Decimal  @default(0) @map("youtube_engagement") @db.Decimal(5, 2)
  youtubeAvgViews    Int      @default(0) @map("youtube_avg_views")

  twitterHandle      String?  @map("twitter_handle")
  twitterFollowers   Int      @default(0) @map("twitter_followers")
  twitterAvgViews    Int      @default(0) @map("twitter_avg_views")

  telegramHandle     String?  @map("telegram_handle")
  telegramFollowers  Int      @default(0) @map("telegram_followers")
  telegramAvgViews   Int      @default(0) @map("telegram_avg_views")

  // Per-platform verification
  twitterVerified   Boolean @default(false) @map("twitter_verified")
  instagramVerified Boolean @default(false) @map("instagram_verified")
  tiktokVerified    Boolean @default(false) @map("tiktok_verified")
  youtubeVerified   Boolean @default(false) @map("youtube_verified")
  telegramVerified  Boolean @default(false) @map("telegram_verified")

  // Pricing (in cents) — legacy fields, kept for compatibility
  pricePerPost  Int? @map("price_per_post")
  pricePerStory Int? @map("price_per_story")
  pricePerVideo Int? @map("price_per_video")

  // Pricing rates (in cents) — single values, not ranges
  cpmRate          Int? @map("cpm_rate")           // CPM rate
  cpcRate          Int? @map("cpc_rate")           // CPC rate
  cpeRate          Int? @map("cpe_rate")           // CPE rate
  averagePostPrice Int? @map("average_post_price") // Average price per post

  // Legacy CPM/CPC/CPE ranges (kept for compatibility)
  cpmMin Int? @map("cpm_min")
  cpmMax Int? @map("cpm_max")
  cpcMin Int? @map("cpc_min")
  cpcMax Int? @map("cpc_max")
  cpeMin Int? @map("cpe_min")
  cpeMax Int? @map("cpe_max")

  // Portfolio
  portfolioImages    String[] @default([]) @map("portfolio_images")
  pastCollaborations String[] @default([]) @map("past_collaborations")

  // Status
  status     InfluencerStatus @default(PENDING)
  isVerified Boolean          @default(false) @map("is_verified")
  isFeatured Boolean          @default(false) @map("is_featured")

  // Metadata
  location  String?
  languages String[] @default([])

  // Wallet
  balance Int @default(0) // earnings balance in cents

  // Founding Member Program
  foundingMember   Boolean   @default(false) @map("founding_member")
  foundingMemberAt DateTime? @map("founding_member_at") @db.Timestamptz

  // Referral Program
  referralCode String @unique @default(dbgenerated("substr(md5(random()::text), 1, 10)")) @map("referral_code")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  profile        Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  collaborations Collaboration[]
  referralsMade    Referral[] @relation("referrer")
  referralsReceived Referral[] @relation("referred")

  @@index([status], map: "idx_influencers_status")
  @@index([isVerified], map: "idx_influencers_verified")
  @@index([isFeatured], map: "idx_influencers_featured")
  @@map("influencers")
}

model Brand {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String @unique @map("user_id") @db.Uuid
  companyName String @map("company_name")
  industry    String?
  website     String?
  description String?
  logoUrl     String? @map("logo_url")

  // Contact info
  contactName  String? @map("contact_name")
  contactEmail String? @map("contact_email")

  // Social Media
  instagramHandle String? @map("instagram_handle")
  twitterHandle   String? @map("twitter_handle")
  telegramHandle  String? @map("telegram_handle")
  youtubeHandle   String? @map("youtube_handle")
  linkedinHandle  String? @map("linkedin_handle")

  // Budget
  monthlyBudgetRange String? @map("monthly_budget_range")

  // Moderation
  isVerified Boolean @default(false) @map("is_verified")
  isBanned   Boolean @default(false) @map("is_banned")

  // Wallet
  balance       Int @default(0) // free balance in cents
  frozenBalance Int @default(0) @map("frozen_balance") // frozen for active collaborations in cents

  // Founding Member Program
  foundingMember   Boolean   @default(false) @map("founding_member")
  foundingMemberAt DateTime? @map("founding_member_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  profile   Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@map("brands")
}

model Campaign {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brandId String @map("brand_id") @db.Uuid

  title       String
  description String?

  // Budget range (in cents)
  budgetMin              Int @map("budget_min")
  budgetMax              Int @map("budget_max")
  desiredInfluencerCount Int @default(1) @map("desired_influencer_count")

  // General deliverables description for the campaign
  deliverables String[] @default([])

  // Campaign details
  goal               String?
  platforms          String[] @default([])
  contentFormats     String[] @default([]) @map("content_formats")
  contentType        String?  @map("content_type")
  influencerNiches   String[] @default([]) @map("influencer_niches")
  pricingModels      String[] @default([]) @map("pricing_models")
  targetViews        String?  @map("target_views")
  targetClicks       String?  @map("target_clicks")
  targetEngagements  String?  @map("target_engagements")

  // Project details
  productName        String?  @map("product_name")
  productPrice       String?  @map("product_price")
  productPhoto       String?  @map("product_photo")
  productLink        String?  @map("product_link")
  productDescription String?  @map("product_description")

  // Instructions for creators
  brandTag           String?  @map("brand_tag")
  hashtags           String?
  creatorScript      String?  @map("creator_script")

  status    CampaignStatus @default(DRAFT)
  startDate DateTime?      @map("start_date") @db.Timestamptz
  endDate   DateTime?      @map("end_date") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  brand          Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  collaborations Collaboration[]

  @@index([brandId], map: "idx_campaigns_brand")
  @@index([status], map: "idx_campaigns_status")
  @@map("campaigns")
}

model Collaboration {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId   String @map("campaign_id") @db.Uuid
  influencerId String @map("influencer_id") @db.Uuid

  // Pricing
  proposedPrice Int  @map("proposed_price") // price proposed by influencer in cents
  agreedPrice   Int? @map("agreed_price") // final agreed price in cents

  // Status & agreement
  status           CollaborationStatus @default(APPLIED)
  brandAgreed      Boolean             @default(false) @map("brand_agreed")
  influencerAgreed Boolean?             @map("influencer_agreed")

  // Details
  deliverables    String[]  @default([])
  message         String?   // influencer's application message
  brandTerms      String?   @map("brand_terms")
  influencerTerms String?   @map("influencer_terms")

  // Content review
  contentUrl     String?   @map("content_url")
  publishedUrl   String?   @map("published_url") // Legacy: single URL, kept for backwards compatibility
  publishedUrls  String[]  @default([]) @map("published_urls") // Array of published URLs per content format
  revisionNote   String?   @map("revision_note")
  revisionCount  Int       @default(0) @map("revision_count")

  // Dispute
  disputeReason  String?   @map("dispute_reason")
  disputeResult  String?   @map("dispute_result")

  // Timestamps
  contentSubmittedAt DateTime? @map("content_submitted_at") @db.Timestamptz
  frozenAt       DateTime? @map("frozen_at") @db.Timestamptz
  completedAt    DateTime? @map("completed_at") @db.Timestamptz
  advancePaidAt  DateTime? @map("advance_paid_at") @db.Timestamptz
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz
  disputedAt     DateTime? @map("disputed_at") @db.Timestamptz
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, influencerId])
  @@index([campaignId])
  @@index([influencerId])
  @@index([status])
  @@index([status, deliveredAt], map: "idx_collabs_status_delivered")
  @@index([status, frozenAt], map: "idx_collabs_status_frozen")
  @@index([status, disputedAt], map: "idx_collabs_status_disputed")
  @@map("collaborations")
}

model Transaction {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  type        TransactionType
  amount      Int // amount in cents (always positive)
  fee         Int             @default(0) // platform fee in cents
  description String?
  referenceId String?         @map("reference_id") @db.Uuid

  status          String    @default("confirmed") // pending, confirmed, failed, expired
  externalId      String?   @map("external_id") // 0xprocessing payment/withdrawal ID
  externalStatus  String?   @map("external_status") // raw status from provider
  walletAddress   String?   @map("wallet_address") // crypto address for withdrawals
  network         String?   // blockchain network
  currency        String?   // crypto currency code
  txHash          String?   @map("tx_hash") // on-chain transaction hash
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz

  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([externalId])
  @@index([userId, createdAt], map: "idx_transactions_user_date")
  @@map("transactions")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  body      String
  isRead    Boolean  @default(false) @map("is_read")
  link      String?  // optional link to navigate to
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([userId, isRead], map: "idx_notifications_user_read")
  @@map("notifications")
}

model PlatformSettings {
  id                   String  @id @default("default")
  depositFeePercent    Decimal @default(2.0) @map("deposit_fee_percent") @db.Decimal(5, 2)
  withdrawalFeePercent Decimal @default(3.0) @map("withdrawal_fee_percent") @db.Decimal(5, 2)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("platform_settings")
}

model Waitlist {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email String @unique

  fullName String? @map("full_name")
  role     String?

  // For influencers
  instagramHandle String? @map("instagram_handle")
  followerCount   String? @map("follower_count")

  // For brands
  companyName String? @map("company_name")
  industry    String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("waitlist")
}

model Referral {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrerId String @map("referrer_id") @db.Uuid // KOL who shared the link
  referredId String @map("referred_id") @db.Uuid // KOL who signed up

  status        String   @default("pending") // pending (signed up) | active (completed onboarding)
  totalEarnings Int      @default(0) @map("total_earnings") // cents earned from this referral

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  referrer Influencer @relation("referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred Influencer @relation("referred", fields: [referredId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId])
  @@index([referrerId])
  @@index([referredId])
  @@map("referrals")
}
